#!/bin/bash

# FreeCAD QuickLook Extensions Registration Script
# This script registers the QuickLook extensions with the system

set -e

echo "Registering FreeCAD QuickLook extensions..."

# Path to the QuickLook host app
QUICKLOOK_HOST="@BUILD_DIR@/FreeCADQuickLookHost.app"

if [ -d "$QUICKLOOK_HOST" ]; then
    echo "Found QuickLook host app at: $QUICKLOOK_HOST"

    # Register the extensions with pluginkit
    echo "Registering with pluginkit..."
    pluginkit -a "$QUICKLOOK_HOST" 2>/dev/null || true

    # Refresh QuickLook cache
    echo "Refreshing QuickLook cache..."
    qlmanage -r 2>/dev/null || true

    echo "QuickLook extensions registered successfully!"

    # Verify registration
    echo "Verifying registration..."
    if pluginkit -m -v -i "org.freecad.FreeCAD.quicklook.thumbnail" 2>/dev/null | grep -q "org.freecad.FreeCAD.quicklook.thumbnail"; then
        echo "✓ Thumbnail extension registered"
    else
        echo "⚠ Thumbnail extension not found in registry"
    fi

    if pluginkit -m -v -i "org.freecad.FreeCAD.quicklook.preview" 2>/dev/null | grep -q "org.freecad.FreeCAD.quicklook.preview"; then
        echo "✓ Preview extension registered"
    else
        echo "⚠ Preview extension not found in registry"
    fi

else
    echo "Error: QuickLook host app not found at $QUICKLOOK_HOST"
    exit 1
fi

echo "Registration complete!"
